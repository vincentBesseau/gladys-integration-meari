{
  "manifest_version": 1,
  "type": "device",
  "name": "Meari",
  "description": {
    "en": "Meari cameras & doorbells: ieGeek Cam, CloudEdge, CloudPlus, ANRAN, Arenti, BoifunCam apps.",
    "fr": "Caméras et sonnettes Meari : applis ieGeek Cam, CloudEdge, CloudPlus, ANRAN, Arenti, BoifunCam."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/OWNER/gladys-integration-meari:0.1.0",
  "gladys_version": ">=5.1.0",
  "categories": [
    "security"
  ],
  "transports": [
    "cloud"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your camera app account",
        "fr": "Le compte de votre application caméra"
      },
      "description": {
        "en": "Meari is the cloud behind ieGeek Cam, CloudEdge, CloudPlus/CloudHome, ANRAN, Arenti and BoifunCam. Use a SECOND account of your app, with your cameras shared to it: the cloud allows one live session per account, so the phone's account delays alerts (15 s instead of instant).",
        "fr": "Meari est le cloud derrière ieGeek Cam, CloudEdge, CloudPlus/CloudHome, ANRAN, Arenti et BoifunCam. Utilisez un DEUXIÈME compte de votre application, avec vos caméras partagées : le cloud n'accepte qu'une session temps réel par compte, et le compte du téléphone retarde les alertes (15 s au lieu d'instantané)."
      }
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "E-mail",
        "fr": "E-mail"
      },
      "placeholder": {
        "en": "name@example.com",
        "fr": "nom@exemple.fr"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "required": true
    },
    {
      "key": "app_profile",
      "type": "select",
      "label": {
        "en": "Your camera app",
        "fr": "Votre application caméra"
      },
      "required": true,
      "default": "iegeek",
      "options": [
        {
          "value": "iegeek",
          "label": {
            "en": "ieGeek Cam",
            "fr": "ieGeek Cam"
          }
        },
        {
          "value": "cloudedge",
          "label": {
            "en": "CloudEdge",
            "fr": "CloudEdge"
          }
        },
        {
          "value": "cloudplus",
          "label": {
            "en": "CloudPlus / CloudHome",
            "fr": "CloudPlus / CloudHome"
          }
        },
        {
          "value": "anran",
          "label": {
            "en": "ANRAN",
            "fr": "ANRAN"
          }
        },
        {
          "value": "boifun",
          "label": {
            "en": "BoifunCam",
            "fr": "BoifunCam"
          }
        },
        {
          "value": "arenti",
          "label": {
            "en": "Arenti",
            "fr": "Arenti"
          }
        }
      ]
    },
    {
      "key": "country_code",
      "type": "string",
      "label": {
        "en": "Country code",
        "fr": "Code pays"
      },
      "description": {
        "en": "Two letters, as chosen in the app (FR, BE, CH...).",
        "fr": "Deux lettres, comme dans l'application (FR, BE, CH...)."
      },
      "default": "FR"
    },
    {
      "key": "phone_code",
      "type": "string",
      "label": {
        "en": "Phone dial code",
        "fr": "Indicatif téléphonique"
      },
      "description": {
        "en": "Without the +, e.g. 33 for France.",
        "fr": "Sans le +, ex. 33 pour la France."
      },
      "default": "33"
    },
    {
      "key": "use_push",
      "type": "boolean",
      "label": {
        "en": "Instant alerts (push)",
        "fr": "Alertes instantanées (push)"
      },
      "description": {
        "en": "Listen to the cloud push channel. Off: alerts arrive by polling, within 15 s.",
        "fr": "Écoute le canal push du cloud. Désactivé : les alertes arrivent par interrogation, sous 15 s."
      },
      "default": true
    },
    {
      "key": "motion_timeout",
      "type": "number",
      "label": {
        "en": "Motion duration (s)",
        "fr": "Durée du mouvement (s)"
      },
      "description": {
        "en": "How long the motion sensor stays on after the last alert.",
        "fr": "Durée pendant laquelle le capteur de mouvement reste actif après la dernière alerte."
      },
      "default": 60,
      "min": 10,
      "max": 3600
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Battery refresh (s)",
        "fr": "Rafraîchissement batterie (s)"
      },
      "description": {
        "en": "Battery and settings are read from the cloud, the camera is never woken up.",
        "fr": "Batterie et réglages sont lus dans le cloud, la caméra n'est jamais réveillée."
      },
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "force_doorbell",
      "type": "boolean",
      "label": {
        "en": "Add a doorbell feature to every camera",
        "fr": "Ajouter une fonction sonnette à toutes les caméras"
      },
      "description": {
        "en": "Only if your doorbell is not detected as one.",
        "fr": "Uniquement si votre sonnette n'est pas reconnue comme telle."
      },
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "doorbell_pressed",
      "label": {
        "en": "Doorbell pressed",
        "fr": "Appui sur la sonnette"
      },
      "description": {
        "en": "Someone pressed the button of a doorbell.",
        "fr": "Quelqu'un a appuyé sur le bouton d'une sonnette."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Doorbell",
            "fr": "Sonnette"
          }
        }
      ]
    },
    {
      "key": "motion_detected",
      "label": {
        "en": "Motion detected",
        "fr": "Mouvement détecté"
      },
      "description": {
        "en": "A camera detected a motion or a person.",
        "fr": "Une caméra a détecté un mouvement ou une personne."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra"
          }
        },
        {
          "key": "target",
          "type": "multi_select",
          "label": {
            "en": "Detection",
            "fr": "Détection"
          },
          "options": [
            {
              "value": "person",
              "label": {
                "en": "Person",
                "fr": "Personne"
              }
            },
            {
              "value": "motion",
              "label": {
                "en": "Other motion",
                "fr": "Autre mouvement"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "target",
          "type": "string",
          "label": {
            "en": "Detection",
            "fr": "Détection"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "camera_view",
      "label": {
        "en": "Meari camera",
        "fr": "Caméra Meari"
      },
      "description": {
        "en": "Last picture, battery and motion. Updated at every alert, without waking the camera.",
        "fr": "Dernière image, batterie et mouvement. Mise à jour à chaque alerte, sans réveiller la caméra."
      },
      "icon": "camera",
      "action_timeout_seconds": 30,
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera (default: the doorbell)",
            "fr": "Caméra (par défaut : la sonnette)"
          }
        }
      ]
    },
    {
      "key": "doorbell_history",
      "label": {
        "en": "Doorbell presses",
        "fr": "Appuis sonnette"
      },
      "description": {
        "en": "The last 5 doorbell presses, day and time, with the picture taken at the press.",
        "fr": "Les 5 derniers appuis sur la sonnette, jour et heure, avec l'image prise à l'appui."
      },
      "icon": "bell",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Doorbell (default: all)",
            "fr": "Sonnette (par défaut : toutes)"
          }
        }
      ]
    }
  ]
}
